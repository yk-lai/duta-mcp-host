# Postgres database this service uses to store each tenant's connector
# credentials — both D365 (encrypted at rest) and the custom fee-waiver
# API (also encrypted at rest) — see GENECO_MCP_CREDENTIAL_ENCRYPTION_KEY.
GENECO_MCP_DATABASE_URL=postgresql+asyncpg://genecomcp:genecomcp-dev@localhost:55441/geneco_mcp

# Fernet key used to encrypt each stored client_secret (D365) and password
# (custom API) — one shared key for both credential kinds. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this should be a key issued by a real KMS/Key Vault, not a
# bare env var — see the project's "deferred security follow-up" note.
GENECO_MCP_CREDENTIAL_ENCRYPTION_KEY=

# Shared secret required on POST/GET/DELETE /{tenant_slug}/credentials and
# /{tenant_slug}/custom-api-credentials (X-Admin-Api-Key header) — the
# stage-1 credential intake endpoints.
GENECO_MCP_ADMIN_API_KEY=dev-admin-key

GENECO_MCP_LOG_LEVEL=INFO
GENECO_MCP_LOG_FORMAT=human
GENECO_MCP_ENV=local
